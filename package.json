{
  "name": "@diplodoc/client",
  "version": "5.14.10",
  "description": "",
  "main": "./build/server/app.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:diplodoc-platform/client.git"
  },
  "scripts": {
    "build": "npm run _build && tsc --emitDeclarationOnly --outDir build",
    "build:dev": "NODE_ENV=development npm run _build",
    "build:watch": "NODE_ENV=development npm run _build -- --watch",
    "_build": "rspack --config ./rspack/config.ts",
    "prepublishOnly": "rm -rf build && npm ci --no-workspaces && npm run build",
    "test": "node --test test/navigation-types.test.cjs test/shared-runtime.test.cjs test/search-url.test.cjs",
    "typecheck": "tsc -p . --noEmit",
    "lint": "lint",
    "lint:fix": "lint fix",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "style": "./build/client/app.css",
      "style-rtl": "./build/app.rtl.css",
      "default": "./build/client/app.js"
    },
    "./ssr": {
      "types": "./build/index.server.d.ts",
      "default": "./build/server/app.js"
    },
    "./manifest": {
      "types": "./manifest.d.ts",
      "default": "./build/client/manifest.json"
    },
    "./styles": "./build/client/app.css"
  },
  "devDependencies": {
    "@diplodoc/components": ">=6.0.0 <7.0.0",
    "@diplodoc/infra": "2.4.0",
    "@diplodoc/latex-extension": "^3.0.0",
    "@diplodoc/mdx-extension": "^1.6.2",
    "@diplodoc/mermaid-extension": "^3.0.0",
    "@diplodoc/openapi-extension": ">=7.0.0 <8.0.0",
    "@diplodoc/page-constructor-extension": ">=1.0.0 <2.0.0",
    "@diplodoc/tabs-extension": "^4.0.0",
    "@diplodoc/transform": "^5.0.0",
    "@gravity-ui/icons": "^2.11.0",
    "@gravity-ui/page-constructor": "^9.0.0",
    "@gravity-ui/uikit": "^8.0.0",
    "@rsdoctor/rspack-plugin": "^1.1.8",
    "@rspack/cli": "^1.4.8",
    "@rspack/core": "^1.4.8",
    "@swc/helpers": "^0.5.17",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/rtlcss": "^3.5.4",
    "bem-cn-lite": "^4.1.0",
    "markdown-it": "^15.0.3",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-svg-loader": "^3.0.0",
    "rspack-manifest-plugin": "^5.0.3",
    "rtlcss": "^4.1.1",
    "sass": "^1.77.0",
    "sass-loader": "^16.0.2",
    "ts-checker-rspack-plugin": "^1.1.4",
    "typescript": "6.0.3",
    "url": "^0.11.4"
  },
  "overrides": {
    "i18next": {
      "typescript": "$typescript"
    },
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
}
