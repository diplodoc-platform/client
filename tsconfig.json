{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["DOM"],
    "declaration": true,
    "outDir": "build",
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": "./src"
  },
  "include": ["./src/*", "./manifest.d.ts"],
  "exclude": ["node_modules"]
}
